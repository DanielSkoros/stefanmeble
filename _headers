# Cloudflare Pages: nagłówki (https://developers.cloudflare.com/pages/configuration/headers/)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Fonty się nie zmieniają: cache na rok
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Zdjęcia mają w adresie wersję (?v=N, patrz script.js): cache na rok
/assets/images/*
  Cache-Control: public, max-age=31536000, immutable

# Ikony mają stałe adresy: tydzień
/assets/icons/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Pliki tekstowe dla robotów i agentów
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
